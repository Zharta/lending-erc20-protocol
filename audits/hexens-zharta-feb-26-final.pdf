12129 0 obj
  << /ActualText (\043 P2PLendingSecuritizeBase\056vy\072418\055432\n\100view\n\100internal\ndef \137get\137oracle\137rate\050oracle\137addr\072 address\054 oracle\137reverse\072 bool\051 \055\076 UInt256Rational\072\n    if oracle\137reverse\072\n        return UInt256Rational\050\n            numerator\07510 \052\052 convert\050staticcall AggregatorV3Interface\050oracle\137addr\051\056decimals\050\051\054 uint256\051\054\n            denominator\075convert\050\n                \050staticcall AggregatorV3Interface\050oracle\137addr\051\056latestRoundData\050\051\051\056answer\054\n                uint256\n            \051\n            \043 No validation that answer \076 0\n        \051\n    else\072\n        return UInt256Rational\050\n            numerator\075convert\050\n                \050staticcall AggregatorV3Interface\050oracle\137addr\051\056latestRoundData\050\051\051\056answer\054)
     /K [ 25 ]
     /P 12130 0 R
