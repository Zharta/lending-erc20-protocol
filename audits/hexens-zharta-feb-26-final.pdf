  << /ActualText (    owner\137key\054\n    securitize\137redemption\137wallet\054\n\051\072\n    \042\042\042\n    Create a redeemed loan where the vault has both payment tokens and residual collateral\056\n    \042\042\042\n    loan \075 ongoing\137loan\137usdc\137weth\n    residual\137collateral \075 loan\056collateral\137amount \057\057 2  \043 Keep 25\045 as collateral\n\n    \043 Redeem the loan with residual collateral\n    p2p\137usdc\137weth\056redeem\050loan\054 residual\137collateral\054 sender\075loan\056borrower\051\n    \043 Update loan state to reflect redemption\n    redeemed\137loan \075 replace\137namedtuple\137field\050\n        loan\054\n        redeem\137start\075now\054\n        redeem\137residual\137collateral\075residual\137collateral\054\n    \051\n\n    \043 Get the vault address for this loan\n    vault\137addr \075 p2p\137usdc\137weth\056vault\137id\137to\137vault\050borrower\054 loan\056vault\137id\051\n\n    \043 Partial payment from redemption \050covers part of debt\051\n    outstanding\137debt\137at\137maturity \075 loan\056amount \053 loan\056get\137interest\050loan\056maturity\051\n    payment\137redeemed \075 outstanding\137debt\137at\137maturity \052 101 \057\057 100 \043 101\045 of debt\n\n    \043 Mint payment tokens to vault\n    usdc\056mint\050vault\137addr\054 payment\137redeemed\051\n\n\n    print\050loan\056collateral\137amount\054 outstanding\137debt\137at\137maturity\051\n\n    \n    \043 Create redeem result\n    redeem\137result \075 RedeemResult\050\n        vault\075vault\137addr\054\n        collateral\137redeemed\0750\054  \043 collateral\137redeemed is from redemption\054 not residual\n        payment\137redeemed\075payment\137redeemed\054\n        timestamp\075now \053 1\054\n        redeem\137wallet\075securitize\137redemption\137wallet\054\n    \051\n\n    return redeemed\137loan\054 redeem\137result\054 payment\137redeemed\054 residual\137collateral\n)
